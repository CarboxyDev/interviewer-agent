# Required for live OpenAI calls. Never commit the real value.
OPENAI_API_KEY=

# Model defaults. Startup checks fail if configured models are unavailable.
INTERVIEWER_STT_MODEL=gpt-live-transcribe
INTERVIEWER_LLM_MODEL=gpt-5.6-luna
INTERVIEWER_TTS_MODEL=gpt-4o-mini-tts
INTERVIEWER_TTS_VOICE=marin
INTERVIEWER_REASONING_EFFORT=none

# Runtime
INTERVIEWER_ENVIRONMENT=development
INTERVIEWER_DATA_DIR=./data
INTERVIEWER_DATABASE_URL=sqlite+aiosqlite:///data/interviewer.db
INTERVIEWER_HOST=0.0.0.0
INTERVIEWER_PORT=8000
INTERVIEWER_LOG_LEVEL=INFO
INTERVIEWER_HEADLESS=false
INTERVIEWER_PARTICIPANT_TIMEOUT_SECONDS=300
INTERVIEWER_CONSENT_TIMEOUT_SECONDS=120
INTERVIEWER_RESPONSE_TIMEOUT_SECONDS=20
