# Required for live OpenAI calls. Never commit the real value.
OPENAI_API_KEY=

# Model defaults. Startup checks fail if configured models are unavailable.
INTERVIEWER_STT_MODEL=gpt-transcribe
INTERVIEWER_LLM_MODEL=gpt-5.6-luna
INTERVIEWER_TTS_MODEL=gpt-4o-mini-tts
INTERVIEWER_TTS_VOICE=cedar
# Supported by the default LLM: none, low, medium, high, xhigh, max.
INTERVIEWER_REASONING_EFFORT=none

# Speech recognition. Delay is used only by transcription models that support that control.
INTERVIEWER_STT_LANGUAGE=en
INTERVIEWER_STT_DELAY=low
INTERVIEWER_STT_VAD_THRESHOLD=0.5
INTERVIEWER_STT_PREFIX_PADDING_MS=300
INTERVIEWER_STT_SILENCE_DURATION_MS=500
# Set either value to 0 to disable that resume and role hint mechanism.
INTERVIEWER_STT_CONTEXT_MAX_CHARS=3000
INTERVIEWER_STT_KEYWORD_LIMIT=40
# Set to 0 to disable the deterministic repeat request for unclear transcripts.
INTERVIEWER_TRANSCRIPT_CLARIFICATION_ATTEMPTS=1

# Runtime
INTERVIEWER_ENVIRONMENT=development
INTERVIEWER_DATA_DIR=./data
INTERVIEWER_DATABASE_URL=sqlite+aiosqlite:///data/interviewer.db
INTERVIEWER_HOST=0.0.0.0
INTERVIEWER_PORT=8000
INTERVIEWER_LOG_LEVEL=INFO
INTERVIEWER_HEADLESS=false
# Persistent profile used by Playwright. Do not commit or share this directory.
INTERVIEWER_BROWSER_PROFILE_DIR=./data/browser-profile
# CDP starts a normal Chromium process, then connects Playwright over loopback.
INTERVIEWER_BROWSER_CONNECTION_MODE=cdp
INTERVIEWER_BROWSER_CDP_PORT=9222
# Localhost-only noVNC desktop for manual setup of a dedicated browser profile.
INTERVIEWER_BROWSER_DESKTOP_PORT=6080
# Docker overrides this with the bundled Google Chrome Stable path.
# Optional for direct local runs. Use only when installed on the same machine.
# INTERVIEWER_BROWSER_CHANNEL=chrome
# INTERVIEWER_BROWSER_EXECUTABLE_PATH=/path/to/browser
INTERVIEWER_PARTICIPANT_TIMEOUT_SECONDS=300
INTERVIEWER_CONSENT_TIMEOUT_SECONDS=120
INTERVIEWER_RESPONSE_TIMEOUT_SECONDS=20
INTERVIEWER_CANDIDATE_TURN_TIMEOUT_SECONDS=120
INTERVIEWER_CANDIDATE_TURN_GRACE_SECONDS=2.0
INTERVIEWER_TTS_TIMEOUT_SECONDS=45
